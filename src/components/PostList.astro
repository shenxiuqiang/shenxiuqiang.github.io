---
// 文章卡片列表。首页和 /blog 页面共用，中英文共用。
import { type Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { getReadingTime, type BlogPost } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: BlogPost[];
	lang: Lang;
}

const { posts, lang } = Astro.props;
const t = useTranslations(lang);
---

{
	posts.length === 0 ? (
		<p>{t.blog.empty}</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a href={localizePath(lang, `/blog/${post.id}`)} class:list={[{ 'has-cover': post.data.cover }]}>
						<div class="card-body">
							<h2>{post.data.title}</h2>
							<p class="excerpt">{post.data.description}</p>
							<p class="meta">
								<FormattedDate date={post.data.pubDate} lang={lang} />
								<span aria-hidden="true">·</span>
								<span>{t.blog.minutes(getReadingTime(post.body, lang))}</span>
								{post.data.tags.map((tag) => (
									<span class="tag">#{tag}</span>
								))}
							</p>
						</div>
						{post.data.cover && (
							<img class="thumb" src={post.data.cover} alt="" loading="lazy" />
						)}
					</a>
				</li>
			))}
		</ul>
	)
}
