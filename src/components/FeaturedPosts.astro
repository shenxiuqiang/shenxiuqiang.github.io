---
/**
 * 首页置顶推荐：把指定 slug 的文章挑出来，在文章列表上方用两列大卡片展示。
 *
 * 【怎么改置顶】
 * 只改下面 FEATURED_SLUGS 这个数组 —— 顺序即展示顺序，最多取前 2 篇。
 * slug 就是 src/content/blog/<lang>/ 下的文件名（不带 .md）。
 * 文件不存在或该语言还没翻译时会被静默跳过，不会生成坏卡片。
 *
 * 【为什么不用 frontmatter 的 featured 字段】
 * 置顶是「首页编辑决策」，不是文章自身的属性；放在这里，
 * 调整推荐位不需要改动文章内容，也不会因为漏写字段而报错。
 */
import FormattedDate from './FormattedDate.astro';
import { localizePath, useTranslations } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
import { getReadingTime, type BlogPost } from '../utils/posts';

const FEATURED_SLUGS = ['arc-tech-overview', 'agent-native-internet'];

const MAX_FEATURED = 2;

interface Props {
	posts: BlogPost[];
	lang: Lang;
}

const { posts, lang } = Astro.props;
const t = useTranslations(lang);

// 按 FEATURED_SLUGS 的顺序取文章；找不到的跳过，避免卡片指向不存在的页面
const featured = FEATURED_SLUGS.slice(0, MAX_FEATURED)
	.map((slug) => posts.find((post) => post.id === slug))
	.filter((post): post is BlogPost => Boolean(post));
---

{
	featured.length > 0 && (
		<section class="featured">
			<div class="featured-head">
				<h2>{t.home.featured}</h2>
			</div>
			<ul class="featured-grid">
				{featured.map((post) => (
					<li>
						<a href={localizePath(lang, `/blog/${post.id}`)}>
							<div class="cover">
								<img src={post.data.cover ?? `/og/${lang}--${post.id}.png`} alt="" loading="eager" />
							</div>
							<div class="body">
								<h3>{post.data.title}</h3>
								<p class="excerpt">{post.data.description}</p>
								<p class="meta">
									<FormattedDate date={post.data.pubDate} lang={lang} />
									<span aria-hidden="true">·</span>
									<span>{t.blog.minutes(getReadingTime(post.body, lang))}</span>
								</p>
								<span class="more">
									{t.home.featuredRead}
									<span aria-hidden="true">→</span>
								</span>
							</div>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.featured {
		margin-bottom: 3rem;
	}

	.featured-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.featured-head h2 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 1.15rem;
	}

	/* 标题前的强调竖条，让置顶区和普通列表一眼区分开 */
	.featured-head h2::before {
		content: '';
		width: 3px;
		height: 1.05em;
		border-radius: 999px;
		background: linear-gradient(var(--accent), var(--accent2));
	}

	.featured-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		/* 两列并排；窄屏在下面降级为单列 */
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.featured-grid li {
		margin: 0;
		min-width: 0;
	}

	.featured-grid a {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		color: inherit;
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			transform 0.15s ease;
	}

	.featured-grid a:hover {
		text-decoration: none;
		background: var(--surface-hover);
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.cover {
		aspect-ratio: 1200 / 630;
		background: var(--bg-soft);
		border-bottom: 1px solid var(--border);
		overflow: hidden;
	}

	.cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.1rem 1.25rem 1.25rem;
	}

	.featured-grid h3 {
		margin: 0 0 0.5rem;
		font-family: var(--font-head);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--text);
		letter-spacing: -0.01em;
		/* 固定两行：两张卡片标题行数一致，正文与底部链接才会横向对齐 */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: calc(2 * 1.4em);
		transition: color 0.15s ease;
	}

	.featured-grid a:hover h3 {
		color: var(--accent);
	}

	.excerpt {
		margin: 0 0 0.85rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--text-body);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--text-soft);
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: auto;
		padding-top: 0.85rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--accent);
	}

	.more span {
		transition: transform 0.15s ease;
	}

	.featured-grid a:hover .more span {
		transform: translateX(3px);
	}

	@media (max-width: 720px) {
		.featured {
			margin-bottom: 2.25rem;
		}

		.featured-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.excerpt {
			-webkit-line-clamp: 2;
		}
	}
</style>
