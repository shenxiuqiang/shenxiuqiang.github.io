---
// 字符 Logo：SHEN / XIU / QIANG 三行左对齐，S/X/Q 加粗高亮。
// 三个关键字母正好都落在最左列，形成一条竖向强调。
// 1px 直角边框；hover 只变色不变粗。
import { SITE_TITLE } from '../consts';
import { type Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<a class="logo" href={localizePath(lang, '/')} aria-label={SITE_TITLE} title={SITE_TITLE}>
	<span class="row"><span class="k">S</span>HEN</span>
	<span class="row"><span class="k">X</span>IU</span>
	<span class="row"><span class="k">Q</span>IANG</span>
</a>

<style>
	.logo {
		/* 正方形（紧凑精细版） */
		width: 46px;
		height: 46px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;

		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 2px;
		padding: 6px 8px;

		/* 直角 + 真 1px 边框 */
		border: 1px solid var(--border-strong);
		border-radius: 0;

		text-decoration: none;
		line-height: 1.15;
		transition: border-color 0.15s ease;
	}

	/* hover 只变色，不变粗 */
	.logo:hover {
		border-color: var(--accent);
	}

	.row {
		display: block; /* 左对齐，不再 space-between */
		text-align: left;
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 10.5px;
		letter-spacing: 0.05em;
		color: var(--text);
		white-space: nowrap;
	}

	.row .k {
		font-weight: 800;
		color: var(--accent);
	}
</style>
