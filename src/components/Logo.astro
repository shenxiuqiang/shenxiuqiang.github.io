---
// 字符 Logo：SHENXIU / QIANG 组成正方形徽章，S/X/Q 加粗高亮。
// 正方形靠 width=height(aspect-ratio 1:1) 固定；两行用 space-between 贴顶/贴底把方块撑满。
import { SITE_TITLE } from '../consts';
import { type Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<a class="logo" href={localizePath(lang, '/')} aria-label={SITE_TITLE} title={SITE_TITLE}>
	<span class="row"
		><span class="k">S</span><span>H</span><span>E</span><span>N</span><span class="k">X</span><span>I</span
		><span>U</span></span
	>
	<span class="row"><span class="k">Q</span><span>I</span><span>A</span><span>N</span><span>G</span></span>
</a>

<style>
	.logo {
		/* 正方形（大号） */
		width: 62px;
		height: 62px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;

		display: flex;
		flex-direction: column;
		justify-content: space-between; /* 两行贴顶/贴底 */
		padding: 9px 10px;

		border: 1.5px solid var(--border-strong);
		border-radius: var(--radius);
		text-decoration: none;
		line-height: 1;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.logo:hover {
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}

	.row {
		display: flex;
		justify-content: space-between; /* 每行字母铺满整宽，对齐成一个方块 */
		width: 100%;
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 15px;
		color: var(--text);
	}

	.row .k {
		font-weight: 800;
		color: var(--accent);
	}
</style>
