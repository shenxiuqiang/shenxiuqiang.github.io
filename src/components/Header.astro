---
import { GITHUB_URL, NAV_LINKS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			{NAV_LINKS.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
			<a class="icon" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		width: var(--wide-width);
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		height: 60px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		font-weight: 700;
		color: var(--text);
		font-size: 1rem;
		white-space: nowrap;
	}

	.brand:hover {
		text-decoration: none;
		color: var(--accent);
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.links :global(a) {
		padding: 0.35rem 0.6rem;
		border-radius: 8px;
		color: var(--text-soft);
		font-size: 0.92rem;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.links :global(a:hover) {
		color: var(--text);
		background: var(--bg-soft);
		text-decoration: none;
	}

	.links :global(a.active) {
		color: var(--accent);
		background: var(--accent-soft);
	}

	.icon {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.5rem;
		color: var(--text-soft);
		border-radius: 8px;
	}

	.icon:hover {
		color: var(--text);
		background: var(--bg-soft);
	}

	@media (max-width: 480px) {
		.brand {
			font-size: 0.95rem;
		}

		.links :global(a) {
			padding: 0.35rem 0.45rem;
			font-size: 0.88rem;
		}
	}
</style>
