---
import { DATE_LOCALE, type Lang } from '../i18n/ui';

interface Props {
	date: Date;
	lang: Lang;
}

const { date, lang } = Astro.props;

// 中文输出「2026年10月7日」，英文输出「October 7, 2026」
const formatted = date.toLocaleDateString(DATE_LOCALE[lang], {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<time datetime={date.toISOString()}>{formatted}</time>
