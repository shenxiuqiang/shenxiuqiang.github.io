---
// 单篇文章的排版外壳。文章正文由 [...slug].astro 通过 <slot /> 塞进来。
import FormattedDate from '../components/FormattedDate.astro';
import { getReadingTime } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	/** 文章原始 Markdown 正文，用来估算阅读时间 */
	body?: string;
}

const { title, description, pubDate, updatedDate, tags = [], body = '' } = Astro.props;
const minutes = getReadingTime(body);
---

<BaseLayout title={title} description={description}>
	<article>
		<header class="post-header">
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				<span aria-hidden="true">·</span>
				<span>约 {minutes} 分钟</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>
								更新于 <FormattedDate date={updatedDate} />
							</span>
						</>
					)
				}
			</p>
			{
				tags.length > 0 && (
					<ul class="tags">
						{tags.map((tag) => (
							<li class="tag">{tag}</li>
						))}
					</ul>
				)
			}
		</header>

		<div class="prose">
			<slot />
		</div>

		<hr />
		<p class="back"><a href="/blog">← 返回文章列表</a></p>
	</article>
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 2rem;
	}

	.post-header h1 {
		margin-bottom: 0.6rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.9rem;
		font-size: 0.85rem;
		color: var(--text-soft);
	}

	.back {
		font-size: 0.9rem;
	}
</style>
