---
// 文章详情页 —— 按 Stitch「Technical Minimalist Editorial」设计稿实现：
// 阅读进度条 + 面包屑 + 作者条 + 头图 + 正文/粘性侧栏两列 + 作者卡 + 上下篇导航。
import AuthorCard from '../components/AuthorCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PrevNext from '../components/PrevNext.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { AUTHOR, GITHUB_URL } from '../consts';
import { type Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { getReadingTime, type BlogPost } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	lang: Lang;
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	cover?: string;
	body?: string;
	altUrl: string;
	headings?: Heading[];
	prev?: BlogPost;
	next?: BlogPost;
}

const {
	lang,
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	cover,
	body = '',
	altUrl,
	headings = [],
	prev,
	next,
} = Astro.props;

const t = useTranslations(lang);
const minutes = getReadingTime(body, lang);
// 字数：中文按字符、英文按词
const cjkCount = (body.match(/[\u4e00-\u9fa5]/g) ?? []).length;
const wordCount = lang === 'zh' ? cjkCount : (body.match(/[a-zA-Z0-9]+/g) ?? []).length;
const initial = AUTHOR.slice(0, 2).toUpperCase();
---

<BaseLayout lang={lang} title={title} description={description} altUrl={altUrl} image={cover} wide>
	<!-- 阅读进度条 -->
	<div class="read-progress" aria-hidden="true"><i id="read-progress-bar"></i></div>

	<!-- 面包屑 + 元信息 -->
	<div class="crumbs">
		<a href={localizePath(lang, '/blog')}>{t.blog.backToList.replace('← ', '')}</a>
		{tags[0] && (
			<>
				<span class="sep">/</span>
				<span class="crumb-tag">{tags[0]}</span>
			</>
		)}
		<span class="crumb-meta">
			<span>{t.post.minutes(minutes)}</span>
			<span class="sep">·</span>
			<span>{t.post.words(wordCount)}</span>
		</span>
	</div>

	<!-- 头部 -->
	<header class="post-header">
		<h1>{title}</h1>
		<p class="lede">{description}</p>
		<div class="byline">
			<div class="who">
				<div class="avatar" aria-hidden="true">{initial}</div>
				<div class="who-text">
					<span class="name">{AUTHOR}</span>
					<span class="date">
						{t.post.publishedOn} <FormattedDate date={pubDate} lang={lang} />
						{updatedDate && (
							<>
								（{t.blog.updatedOn} <FormattedDate date={updatedDate} lang={lang} />）
							</>
						)}
					</span>
				</div>
			</div>
			<div class="actions">
				<button class="ghost-btn" id="share-btn" type="button">
					<span class="share-label">{t.post.share}</span>
				</button>
				<a class="ghost-btn icon" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" title="GitHub">
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
				</a>
			</div>
		</div>
	</header>

	<!-- 头图 -->
	{
		cover && (
			<figure class="cover">
				<img src={cover} alt={title} loading="eager" />
			</figure>
		)
	}

	<!-- 正文 + 侧栏 -->
	<div class="reader">
		<article class="prose">
			<slot />

			{tags.length > 0 && (
				<ul class="tags post-tags">
					{tags.map((tag) => (
						<li class="tag">#{tag}</li>
					))}
				</ul>
			)}

			<AuthorCard lang={lang} />
			<PrevNext lang={lang} prev={prev} next={next} />
		</article>

		<aside class="sidebar">
			<TableOfContents headings={headings} lang={lang} />
			<div class="stats">
				<div class="stat"><b>{wordCount}</b><span>{t.post.characters}</span></div>
				<div class="stat"><b>{minutes}</b><span>{t.post.readingTime}</span></div>
			</div>
			<button class="scroll-top" id="scroll-top-btn" type="button">↑ {t.post.backToTop}</button>
		</aside>
	</div>
</BaseLayout>

<script>
	// 阅读进度条
	const bar = document.getElementById('read-progress-bar');
	const onScroll = () => {
		const h = document.documentElement;
		const max = h.scrollHeight - h.clientHeight;
		if (bar && max > 0) bar.style.width = (h.scrollTop / max) * 100 + '%';
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// 回到顶部
	document.getElementById('scroll-top-btn')?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});

	// 分享（复制链接）
	const shareBtn = document.getElementById('share-btn');
	shareBtn?.addEventListener('click', async () => {
		const label = shareBtn.querySelector('.share-label');
		const orig = label?.textContent;
		try {
			await navigator.clipboard.writeText(window.location.href);
			if (label) label.textContent = '✓';
			setTimeout(() => { if (label && orig) label.textContent = orig; }, 1600);
		} catch {}
	});

	// 代码块加 macOS 标题栏 + 复制按钮
	document.querySelectorAll('pre.astro-code').forEach((pre) => {
		if (pre.parentElement?.classList.contains('code-block')) return;
		const lang = pre.getAttribute('data-language') || 'code';
		const wrap = document.createElement('div');
		wrap.className = 'code-block';
		const head = document.createElement('div');
		head.className = 'code-head';
		const langLabel = document.createElement('span');
		langLabel.className = 'code-lang';
		langLabel.textContent = lang;
		head.appendChild(langLabel);
		const btn = document.createElement('button');
		btn.className = 'code-copy';
		btn.type = 'button';
		btn.textContent = 'copy';
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.innerText);
				btn.textContent = 'copied';
				setTimeout(() => (btn.textContent = 'copy'), 1600);
			} catch {}
		});
		head.appendChild(btn);
		pre.parentNode?.insertBefore(wrap, pre);
		wrap.appendChild(head);
		wrap.appendChild(pre);
	});

	// TOC 滚动高亮
	const tocLinks = document.querySelectorAll('.toc a[data-toc]');
	if (tocLinks.length) {
		const map = new Map();
		tocLinks.forEach((a) => {
			const el = document.getElementById(a.getAttribute('data-toc'));
			if (el) map.set(el, a);
		});
		const spy = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					const a = map.get(e.target);
					if (!a) return;
					if (e.isIntersecting) {
						tocLinks.forEach((l) => l.classList.remove('active'));
						a.classList.add('active');
					}
				});
			},
			{ rootMargin: '-80px 0px -70% 0px' }
		);
		map.forEach((_, el) => spy.observe(el));
	}
</script>

<style>
	.read-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: transparent;
		z-index: 50;
		pointer-events: none;
	}

	.read-progress i {
		display: block;
		height: 100%;
		width: 0;
		background: var(--accent);
		transition: width 0.08s linear;
	}

	.crumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-soft);
		margin-bottom: 1.75rem;
	}

	.crumbs a {
		color: var(--text-soft);
	}

	.crumbs a:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.crumbs .sep {
		color: var(--border-strong);
	}

	.crumb-tag {
		color: var(--accent2);
	}

	.crumb-meta {
		margin-left: auto;
		display: flex;
		gap: 0.5rem;
	}

	.post-header h1 {
		margin-bottom: 0.75rem;
	}

	.lede {
		font-size: 1.05rem;
		color: var(--text-soft);
		line-height: 1.6;
		margin-bottom: 1.25rem;
	}

	.byline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		padding-bottom: 1.5rem;
	}

	.who {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	.avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--accent);
		color: var(--on-accent);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 0.85rem;
		flex-shrink: 0;
	}

	.who-text {
		display: flex;
		flex-direction: column;
	}

	.who-text .name {
		font-family: var(--font-head);
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--text);
	}

	.who-text .date {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-soft);
	}

	.actions {
		display: flex;
		gap: 0.5rem;
	}

	.ghost-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text-soft);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.ghost-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.ghost-btn.icon {
		padding: 0.4rem 0.55rem;
	}

	.cover {
		margin: 0 0 2.25rem;
	}

	.cover img {
		width: 100%;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		display: block;
	}

	/* 两列：正文 + 粘性侧栏 */
	.reader {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.sidebar {
		display: none;
	}

	@media (min-width: 1024px) {
		.reader {
			grid-template-columns: minmax(0, 1fr) 300px;
		}

		.sidebar {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			position: sticky;
			top: 5rem;
		}
	}

	.stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
	}

	.stat {
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.75rem 0.5rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.stat b {
		font-family: var(--font-mono);
		font-size: 1.05rem;
		color: var(--accent);
		font-weight: 700;
	}

	.stat span {
		font-size: 0.72rem;
		color: var(--text-soft);
	}

	.scroll-top {
		padding: 0.55rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface-raised);
		color: var(--text-soft);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.scroll-top:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.post-tags {
		margin: 2rem 0;
	}

	.prose :global(article) {
		/* slot 内容 */
	}
</style>
