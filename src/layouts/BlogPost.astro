---
// 单篇文章的排版外壳。正文由 [lang]/blog/[...slug].astro 通过 <slot /> 塞进来。
import FormattedDate from '../components/FormattedDate.astro';
import { type Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { getReadingTime } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	lang: Lang;
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	/** 封面图（public/ 下的路径），用于头图和社交分享图 */
	cover?: string;
	/** 文章原始 Markdown 正文，用来估算阅读时间 */
	body?: string;
	altUrl: string;
}

const { lang, title, description, pubDate, updatedDate, tags = [], cover, body = '', altUrl } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={title} description={description} altUrl={altUrl} image={cover}>
	<article>
		<a class="back-top" href={localizePath(lang, '/blog')}>{t.blog.backToList}</a>

		<header class="post-header">
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} lang={lang} />
				<span aria-hidden="true">·</span>
				<span>{t.blog.minutes(getReadingTime(body, lang))}</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>
								{t.blog.updatedOn} <FormattedDate date={updatedDate} lang={lang} />
							</span>
						</>
					)
				}
			</p>
			{
				tags.length > 0 && (
					<ul class="tags">
						{tags.map((tag) => (
							<li class="tag">{tag}</li>
						))}
					</ul>
				)
			}
		</header>

		{
			cover && (
				<figure class="cover">
					<img src={cover} alt={title} loading="eager" />
				</figure>
			)
		}

		<div class="prose">
			<slot />
		</div>

		<hr />
		<p class="back"><a href={localizePath(lang, '/blog')}>{t.blog.backToList}</a></p>
	</article>
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 2rem;
	}

	.back-top {
		display: inline-flex;
		align-items: center;
		margin-bottom: 1.5rem;
		padding: 0.35rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.85rem;
		color: var(--text-soft);
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.back-top:hover {
		color: var(--accent);
		border-color: var(--accent);
		text-decoration: none;
	}

	.post-header h1 {
		margin-bottom: 0.6rem;
	}

	.cover {
		margin: 0 0 2rem;
	}

	.cover img {
		width: 100%;
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		display: block;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.9rem;
		font-size: 0.85rem;
		color: var(--text-soft);
	}

	.back {
		font-size: 0.9rem;
	}
</style>
