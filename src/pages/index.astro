---
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>你好，我是 {SITE_TITLE} 👋</h1>
		<p>
			这里是我的个人博客。用 Markdown 写内容，由 <a
				href="https://astro.build"
				target="_blank"
				rel="noopener noreferrer">Astro</a
			> 在构建时生成静态页面，再通过 GitHub Actions 自动发布到 GitHub Pages。
		</p>
		<p>
			想了解这套流程怎么搭起来的，可以看 <a href="/blog/hello-astro">第一篇文章</a>。
		</p>
	</section>

	<section>
		<div class="section-head">
			<h2>最近文章</h2>
			<a class="more" href="/blog">全部 {posts.length} 篇 →</a>
		</div>
		<PostList posts={recent} />
	</section>
</BaseLayout>

<style>
	.intro {
		margin-bottom: 3rem;
	}

	.intro h1 {
		font-size: 1.9rem;
		margin-bottom: 1rem;
	}

	.intro p {
		color: var(--text-soft);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.section-head h2 {
		margin: 0;
		font-size: 1.15rem;
	}

	.more {
		font-size: 0.85rem;
		white-space: nowrap;
	}
</style>
