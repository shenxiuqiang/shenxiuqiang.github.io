---
// 旧地址：/blog/<文件名>/ → /zh/blog/<文件名>/
// 这些链接已经发布出去了（搜索引擎、转载、书签），所以逐一生成跳转页。
import Redirect from '../../components/Redirect.astro';
import { getPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts('zh');

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { slug: post.id },
	}));
}

const { slug } = Astro.props as { slug: string };
---

<Redirect to={`/zh/blog/${slug}/`} />
