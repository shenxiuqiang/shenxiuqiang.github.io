---
import PostList from '../../../components/PostList.astro';
import { LOCALES, type Lang } from '../../../i18n/ui';
import { localizePath, useTranslations } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, warnMissingTranslations } from '../../../utils/posts';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const posts = await getPosts(lang);
await warnMissingTranslations();

const other: Lang = lang === 'zh' ? 'en' : 'zh';
const altUrl = localizePath(other, '/blog');
---

<BaseLayout lang={lang} title={t.blog.title} description={t.blog.description} altUrl={altUrl}>
	<h1>{t.blog.title}</h1>
	<p class="count">{t.blog.count(posts.length)}</p>
	<PostList posts={posts} lang={lang} />
</BaseLayout>

<style>
	h1 {
		margin-bottom: 0.4rem;
	}

	.count {
		color: var(--text-soft);
		font-size: 0.9rem;
		margin-bottom: 2rem;
	}
</style>
