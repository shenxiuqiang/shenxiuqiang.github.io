---
import type { GetStaticPathsOptions, Page } from 'astro';
import Pagination from '../../../components/Pagination.astro';
import PostList from '../../../components/PostList.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { LOCALES, type Lang } from '../../../i18n/ui';
import { localizePath, useTranslations } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, getPosts, PAGE_SIZE, warnMissingTranslations, type BlogPost } from '../../../utils/posts';

// 用 paginate() 做静态分页：每种语言生成 /blog/、/blog/2/、/blog/3/ …
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const paths = [];
	for (const lang of LOCALES) {
		const posts = await getPosts(lang);
		paths.push(...paginate(posts, { pageSize: PAGE_SIZE, params: { lang } }));
	}
	return paths;
}

const { lang } = Astro.params as { lang: Lang };
const page = Astro.props.page as Page<BlogPost>;
const t = useTranslations(lang);

const tags = await getAllTags(lang);

await warnMissingTranslations();

const other: Lang = lang === 'zh' ? 'en' : 'zh';
const altUrl = localizePath(other, '/blog');
---

<BaseLayout lang={lang} title={t.blog.title} description={t.blog.description} altUrl={altUrl} wide>
	<h1>{t.blog.title}</h1>
	<p class="count">{t.blog.count(page.total)}</p>
	<TagFilter lang={lang} tags={tags} />
	<PostList posts={page.data} lang={lang} />
	<Pagination page={page} lang={lang} />
</BaseLayout>

<style>
	h1 {
		margin-bottom: 0.4rem;
	}

	.count {
		color: var(--text-soft);
		font-size: 0.9rem;
		margin-bottom: 2rem;
	}
</style>
