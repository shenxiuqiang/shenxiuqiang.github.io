---
import { render } from 'astro:content';
import { LOCALES, type Lang } from '../../../i18n/ui';
import { localizePath } from '../../../i18n/utils';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getPosts } from '../../../utils/posts';

/**
 * Astro 是静态站点生成器：构建时这里会为每篇文章执行一次，
 * 生成对应的 /<lang>/blog/<文件名>/index.html。
 * 译文配对靠文件名：中英文目录下同名的文件被视为同一篇文章。
 */
export async function getStaticPaths() {
	const [zhPosts, enPosts] = await Promise.all([getPosts('zh'), getPosts('en')]);
	const slugs = {
		zh: new Set(zhPosts.map((post) => post.id)),
		en: new Set(enPosts.map((post) => post.id)),
	};

	return LOCALES.flatMap((lang) => {
		const posts = lang === 'zh' ? zhPosts : enPosts;
		const other: Lang = lang === 'zh' ? 'en' : 'zh';

		return posts.map((post, i) => ({
			params: { lang, slug: post.id },
			props: {
				lang,
				post,
				// posts 按时间倒序：i-1 是更新的（下一篇），i+1 是更旧的（上一篇）
				prev: posts[i + 1],
				next: posts[i - 1],
				// 有译文就链到译文；还没翻译就退到对方的文章列表
				altUrl: slugs[other].has(post.id)
					? localizePath(other, `/blog/${post.id}`)
					: localizePath(other, '/blog'),
			},
		}));
	});
}

const { lang, post, altUrl, prev, next } = Astro.props;

// render() 把 Markdown 编译成 <Content />，并给出 headings 用于生成目录
const { Content, headings } = await render(post);
---

<BlogPost
	lang={lang}
	{...post.data}
	body={post.body}
	altUrl={altUrl}
	headings={headings}
	prev={prev}
	next={next}
>
	<Content />
</BlogPost>
