---
import type { GetStaticPathsOptions, Page } from 'astro';
import HeroConstellation from '../../components/HeroConstellation.astro';
import Pagination from '../../components/Pagination.astro';
import PostList from '../../components/PostList.astro';
import SaveListUrl from '../../components/SaveListUrl.astro';
import { SITE_TITLE } from '../../consts';
import { LOCALES, type Lang } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, PAGE_SIZE, warnMissingTranslations, type BlogPost } from '../../utils/posts';

// 首页也是分页列表：/zh/ 是第 1 页（带简介），/zh/2/、/zh/3/ … 是后续页
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const paths = [];
	for (const lang of LOCALES) {
		const posts = await getPosts(lang);
		paths.push(...paginate(posts, { pageSize: PAGE_SIZE, params: { lang } }));
	}
	return paths;
}

const { lang } = Astro.params as { lang: Lang };
const page = Astro.props.page as Page<BlogPost>;
const t = useTranslations(lang);
const isFirstPage = page.currentPage === 1;

await warnMissingTranslations();

const other: Lang = lang === 'zh' ? 'en' : 'zh';
const altUrl = localizePath(other, '/');
---

<BaseLayout lang={lang} title={SITE_TITLE} description={t.siteDescription} altUrl={altUrl} wide>
	{/* 知识星图 Hero 只在第 1 页显示 */}
	{isFirstPage && <HeroConstellation lang={lang} />}

	<section>
		<div class="section-head">
			<h2>{t.blog.title}</h2>
			<span class="total">{t.blog.count(page.total)}</span>
		</div>
		<PostList posts={page.data} lang={lang} />
		<Pagination page={page} lang={lang} />
	</section>
	<SaveListUrl lang={lang} />
</BaseLayout>

<style>
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.section-head h2 {
		margin: 0;
		font-size: 1.15rem;
	}

	.total {
		font-size: 0.85rem;
		color: var(--text-soft);
	}
</style>
